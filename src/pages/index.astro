---
import { getCollection } from "astro:content";
import PagesLayout from "@layouts/PagesLayout.astro";

const basicsEntries = await getCollection("learn", ({ slug, data }) => {
  return slug.endsWith("/basics") && data.live === true;
});

const FAMILY_ORDER = [
  "Altaic",
  "Central Semitic",
  "Indo-Iranian",
  "Italic-Latin",
  "Niger-Congo",
  "Slavic",
];

// Languages with no content yet — remove an entry here once its basics file goes live
const COMING_SOON = [
  { language: "Mandarin", family: "Altaic" },
  { language: "Hebrew", family: "Central Semitic" },
  { language: "Hindi", family: "Indo-Iranian" },
  { language: "Spanish", family: "Italic-Latin" },
  { language: "Ndebele", family: "Niger-Congo" },
  { language: "Bulgarian", family: "Slavic" },
];

const families = {};

// Seed every family so grid columns render even with only placeholders
for (const family of FAMILY_ORDER) {
  families[family] = { live: [], comingSoon: [] };
}

basicsEntries.forEach((entry) => {
  const family = entry.data.family ?? "Uncategorised";
  families[family] ??= { live: [], comingSoon: [] };
  families[family].live.push(entry);
});

COMING_SOON.forEach(({ language, family }) => {
  families[family] ??= { live: [], comingSoon: [] };
  families[family].comingSoon.push(language);
});
---

<PagesLayout>
  <div class="grid place-items-center">
    <section>
      <h1
        class="text-center text-3xl font-semibold text-sky-700 sm:mb-8 md:mb-12 md:text-4xl lg:text-5xl"
      >
        The Language Hub
      </h1>
      <p class="mb-8 text-center text-base text-gray-600 md:text-lg lg:text-xl">
        Welcome to your language reference book. <br />
        What path do you choose?
      </p>
      <article
        class="mb-16 md:mb-28 grid gap-6 text-gray-600 sm:grid-cols-2 md:grid-cols-3"
      >
        {
          FAMILY_ORDER.map((family) => (
            <div class="py-4 px-6 shadow shadow-gray-400">
              <h3 class="mb-1">{family}</h3>
              <div class="space-y-3 text-center">
                {families[family].live.map((entry) => (
                  <a href={`/${entry.slug}`} class="lang-path">
                    {entry.data.title.replace(" Basics", "")}
                  </a>
                ))}
                {families[family].comingSoon.map((language) => (
                  <p class="block rounded border border-gray-500 py-2 px-10 text-gray-400">
                    {language}
                  </p>
                ))}
              </div>
            </div>
          ))
        }
      </article>
    </section>
  </div>
</PagesLayout>
